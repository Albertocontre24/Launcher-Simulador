<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher.App"
        mc:Ignorable="d"
        Title="Launcher 2.0" Height="800" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackground}">

	<!-- Estilos locales -->
	<Window.Resources>

		<!-- ======= Tu botón "glass" (sin cambios) ======= -->
		<Style x:Key="GlassButtonStyle" TargetType="Button" BasedOn="{StaticResource BotonTexto}">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontFamily" Value="{StaticResource ManropeBold}"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Padding" Value="12,8"/>
			<Setter Property="MinWidth" Value="120"/>
			<Setter Property="Background" Value="#60FFFFFF"/>
			<Setter Property="BorderBrush" Value="#40FFFFFF"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="UseLayoutRounding" Value="True"/>
			<Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
			<Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid RenderTransformOrigin="0.5,0.5">
							<Border x:Name="border"
									CornerRadius="12"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}">
								<Border.Effect>
									<DropShadowEffect Color="#1A000000" BlurRadius="10" ShadowDepth="2"/>
								</Border.Effect>
								<Grid>
									<Rectangle RadiusX="12" RadiusY="12" IsHitTestVisible="False" Opacity="0.6" Fill="#40FFFFFF"/>
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Grid>
							</Border>
							<Border CornerRadius="12" BorderThickness="1" BorderBrush="#20FFFFFF" Margin="1" IsHitTestVisible="False"/>
						</Grid>

						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.95"/>
								<Setter TargetName="border" Property="RenderTransform">
									<Setter.Value>
										<ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
									</Setter.Value>
								</Setter>
								<Setter TargetName="border" Property="Background">
									<Setter.Value>
										<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
											<GradientStop Color="#FF5B41" Offset="0"/>
											<GradientStop Color="#FF5B41" Offset="1"/>
										</LinearGradientBrush>
									</Setter.Value>
								</Setter>
							</Trigger>

							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="border" Property="Opacity" Value="0.9"/>
								<Setter TargetName="border" Property="RenderTransform">
									<Setter.Value>
										<ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
									</Setter.Value>
								</Setter>
							</Trigger>

							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.5"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ======= Paleta para chips de estado ======= -->
		<SolidColorBrush x:Key="OkBg"   Color="#0E2A1E"/>
		<SolidColorBrush x:Key="OkBd"   Color="#28C76F"/>
		<SolidColorBrush x:Key="OkFg"   Color="#D9FFE9"/>
		<SolidColorBrush x:Key="WarnBg" Color="#2C1A1A"/>
		<SolidColorBrush x:Key="WarnBd" Color="#E14C4C"/>
		<SolidColorBrush x:Key="WarnFg" Color="#FFE4E4"/>

		<!-- Icono MDL2 para chips -->
		<Style x:Key="Glyph" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,6,0"/>
		</Style>

		<!-- Contenedor reutilizable tipo "chip" -->
		<Style x:Key="InfoChip" TargetType="Border">
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="Margin" Value="6,10,6,0"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>

		<!-- ======= ProgressBar redondeada ======= -->
		<Style x:Key="RoundedProgress" TargetType="ProgressBar">
			<Setter Property="Height" Value="16"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ProgressBar">
						<Grid x:Name="Root" ClipToBounds="True">
							<Border CornerRadius="8" Background="#1C2B42" BorderBrush="#223344" BorderThickness="1"/>
							<Border x:Name="PART_Track" CornerRadius="8" Background="Transparent"/>
							<Border x:Name="PART_Indicator" CornerRadius="8" Background="#1ABC9C"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsIndeterminate" Value="True">
								<Setter TargetName="PART_Indicator" Property="Opacity" Value="0.6"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</Window.Resources>

	<DockPanel LastChildFill="True">

		<Image Source="Assets/logoesquina.png"
			   DockPanel.Dock="Bottom"
			   HorizontalAlignment="Left"
			   VerticalAlignment="Bottom"
			   Margin="8,0,0,8"
			   Width="120"
			   Stretch="Uniform"
			   Panel.ZIndex="10"/>

		<Menu DockPanel.Dock="Top" Background="{StaticResource PrimaryBackground}" FontFamily="{StaticResource ManropeRegular}">
			<MenuItem Header="_Archivo" Foreground="Black">
				<MenuItem Header="Abrir..." Foreground="Black" />
				<Separator />
				<MenuItem Header="Salir" Foreground="Black" Click="MenuSalir_Click"/>
			</MenuItem>
			<MenuItem Header="_Ver" Foreground="Black">
				<MenuItem Header="Actualizar" Foreground="Black" IsCheckable="True" Click="MenuActualizar_Click"/>
			</MenuItem>
			<MenuItem Header="_Ayuda" Foreground="Black">
				<MenuItem Header="Acerca de..." Foreground="Black" Click="MenuAcercaDe_Click"/>
			</MenuItem>
		</Menu>

		<Border DockPanel.Dock="Top" Padding="2" Background="#003594">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
					<Image Source="Assets/logo.png" Width="100" Height="100" Margin="0,0,10,0"/>
				</StackPanel>

				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock Text="Mi Launcher" Style="{StaticResource Titulo}" />
					<TextBlock Text="Panel principal" Style="{StaticResource Texto}" Foreground="{StaticResource SecondaryText}"/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
					<Button Content="Actualizar" Click="BtnActualizar_Click" Padding="8,4" Margin="0,0,8,0" Style="{StaticResource GlassButtonStyle}" Height="30" Width="125"/>
					<Button Content="Configuración" Click="BtnConfiguracion_Click" Padding="8,4" Style="{StaticResource GlassButtonStyle}"/>
				</StackPanel>
			</Grid>
		</Border>

		<Grid Margin="12">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<TabControl Grid.Row="0"
                        x:Name="MainTabs"
                        Margin="0,0,0,10"
                        Height="36"
                        Background="{StaticResource PrimaryBackground}"
                        BorderThickness="0"
                        FontFamily="{StaticResource ManropeSemiBold}"
                        SelectionChanged="MainTabs_SelectionChanged">
				<TabItem Header="Inicio" />
				<TabItem Header="Historial" />
			</TabControl>

			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="3*"/>
					<ColumnDefinition Width="2*"/>
				</Grid.ColumnDefinitions>

				<!-- ESTADO -->
				<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock Text="Estado" Style="{StaticResource TituloSecundario}" Margin="6" Foreground="#003594"/>

						<!-- Tarjeta: Estado del launcher -->
						<Border Style="{StaticResource CardStyle}">
							<StackPanel>
								<TextBlock Text="Estado del launcher" Style="{StaticResource TextoDestacado}" FontSize="16" Margin="0,0,0,10"/>

								<!-- Versión instalada -->
								<StackPanel Orientation="Horizontal" Margin="0,4">
									<TextBlock Text="Versión instalada:" Style="{StaticResource TextoDestacado}" Width="160"/>
									<TextBlock Text="{Binding GameStatus.VersionInstalada}" Style="{StaticResource Texto}"/>
								</StackPanel>

								<!-- Última versión -->
								<StackPanel Orientation="Horizontal" Margin="0,4">
									<TextBlock Text="Última versión:" Style="{StaticResource TextoDestacado}" Width="160"/>
									<TextBlock Text="{Binding GameStatus.UltimaVersion}" Style="{StaticResource Texto}"/>
								</StackPanel>

								<!-- Estado general -->
								<StackPanel Orientation="Horizontal" Margin="0,8">
									<Image Source="{Binding GameStatus.IconoEstado}" Width="18" Height="18" Margin="0,0,6,0"/>
									<TextBlock Text="{Binding GameStatus.TextoEstado}" Style="{StaticResource Texto}"/>
								</StackPanel>

								<!-- Mensaje + Progreso -->
								<StackPanel Margin="0,8,0,0">
									<TextBlock Text="{Binding GameStatus.Mensaje}"
											   Style="{StaticResource Texto}"
											   TextWrapping="Wrap"
											   Margin="0,0,0,6"/>

									<ProgressBar Style="{StaticResource RoundedProgress}"
												 Minimum="0" Maximum="100"
												 Value="{Binding GameStatus.Progreso, Mode=OneWay}"
												 IsIndeterminate="{Binding GameStatus.IsTrabajando, Mode=OneWay}"/>

									<TextBlock Margin="0,4,0,0" Style="{StaticResource Texto}" Opacity="0.85">
										<Run Text="Progreso: "/>
										<Run Text="{Binding GameStatus.Progreso, StringFormat={}{0:F1}%}"/>
									</TextBlock>
								</StackPanel>

								<!-- CHIP "bueno" (verde con botones) abajo -->
								<Border Background="{StaticResource OkBg}" BorderBrush="{StaticResource OkBd}">
									<DockPanel LastChildFill="True" ToolTip="{Binding GameStatus.RutaExe}">
										<TextBlock Style="{StaticResource Glyph}" Foreground="{StaticResource OkBd}" Text="&#xE73E;"/>
										<TextBlock Foreground="{StaticResource OkFg}" TextTrimming="CharacterEllipsis">
											<Run Text="Ejecutable detectado: "/>
											<!-- Mostrar solo el nombre del .exe -->
											<Run Text="{Binding GameStatus.NombreExe, Mode=OneWay}"/>
										</TextBlock>

										<StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
											<Button Style="{StaticResource GlassButtonStyle}" Height="24" Padding="10,0"
													Click="BtnCopiarRuta_Click" Content="Copiar ruta" Margin="0,0,6,0"/>
											<Button Style="{StaticResource GlassButtonStyle}" Height="24" Padding="10,0"
													Click="BtnAbrirCarpeta_Click" Content="Abrir carpeta"/>
										</StackPanel>
									</DockPanel>

									<Border.Style>
										<Style TargetType="Border" BasedOn="{StaticResource InfoChip}">
											<Setter Property="Visibility" Value="Collapsed"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding GameStatus.Instalado}" Value="True">
													<Setter Property="Visibility" Value="Visible"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
								</Border>

								<!-- ❌ CHIP: no detectado (visible solo si Instalado=False) -->
								<Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBd}">
									<DockPanel LastChildFill="True">
										<TextBlock Style="{StaticResource Glyph}" Foreground="{StaticResource WarnBd}" Text="&#xE783;"/>
										<TextBlock Foreground="{StaticResource WarnFg}" TextWrapping="Wrap">
											<Run Text="No se encontró el ejecutable. "/>
											<Run Text="Pulsa "/>
											<Run Text="Actualizar" FontWeight="Bold"/>
											<Run Text=" o verifica que el ZIP incluya "/>
											<Run Text="Build/TestLauncher.exe" FontWeight="Bold"/>
											<Run Text="."/>
										</TextBlock>
									</DockPanel>

									<Border.Style>
										<Style TargetType="Border" BasedOn="{StaticResource InfoChip}">
											<Setter Property="Visibility" Value="Collapsed"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding GameStatus.Instalado}" Value="False">
													<Setter Property="Visibility" Value="Visible"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
								</Border>

							</StackPanel>
						</Border>

						<!-- Tarjeta: Conexión -->
						<Border Style="{StaticResource CardStyle}">
							<StackPanel>
								<TextBlock Text="Conexión:" Style="{StaticResource TextoDestacado}"/>
								<TextBlock Text="{Binding LauncherStatus.ConnectionText}" Style="{StaticResource Texto}" Margin="0,4,0,8"/>
								<TextBlock Text="Versión:" Style="{StaticResource TextoDestacado}"/>
								<TextBlock Text="{Binding LauncherStatus.Version}" Style="{StaticResource Texto}" Margin="0,4,0,8"/>
								<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
									<Button Content="Revisar actualizaciones" Click="BtnRevisarActualizaciones_Click" Padding="8,4" Margin="8,0,0,0" Style="{StaticResource GlassButtonStyle}" Height="30" Width="180"/>
									<Button Content="Reiniciar" Click="BtnReiniciar_Click" Padding="8,4" Margin="8,0,0,0" Style="{StaticResource GlassButtonStyle}" Height="30" Width="125"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- Tarjeta Actividades -->
						<Border Style="{StaticResource CardStyle}">
							<StackPanel>
								<TextBlock Text="Actividades recientes" Style="{StaticResource TextoDestacado}"/>
								<ItemsControl ItemsSource="{Binding RecentActivities}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock TextWrapping="Wrap" Style="{StaticResource Texto}">
												<Run Text="• "/>
												<Run Text="{Binding}" />
											</TextBlock>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>

				<!-- NOTICIAS -->
				<StackPanel Grid.Column="1">
					<TextBlock Text="Noticias"
							   Style="{StaticResource TituloSecundario}"
							   Margin="8.5"
							   Foreground="#003594"/>

					<Border Style="{StaticResource CardStyle}"
							VerticalAlignment="Stretch"
							Padding="10"
							Margin="0,4,0,0">

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>

							<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
								<TextBlock Text="Versión:"
										   Style="{StaticResource Texto}"
										   VerticalAlignment="Center"
										   Margin="0,0,6,0"/>
								<ComboBox Width="140"
										  SelectedIndex="0"
										  FontFamily="{StaticResource ManropeRegular}"
										  SelectionChanged="ComboBox_SelectionChanged">
									<ComboBoxItem Content="Actual"/>
									<ComboBoxItem Content="Anterior"/>
								</ComboBox>
							</StackPanel>

							<ScrollViewer Grid.Row="1"
										  VerticalScrollBarVisibility="Auto"
										  Margin="0,8,0,0">
								<StackPanel>
									<TextBlock Text="{Binding GameStatus.TituloNoticia}"
											   FontFamily="{StaticResource ManropeSemiBold}"
											   FontSize="15"
											   Foreground="#FFEBEBEB"
											   Margin="0,0,0,8"/>

									<TextBlock Text="{Binding GameStatus.UltimaNoticia}"
											   TextWrapping="Wrap"
											   Foreground="White"
											   FontFamily="{StaticResource ManropeRegular}"
											   FontSize="14"
											   LineHeight="20"
											   Padding="4"
											   TextAlignment="Left"/>
								</StackPanel>
							</ScrollViewer>
						</Grid>
					</Border>
				</StackPanel>

				<!-- Contenedor en la MISMA celda donde estaba el botón -->
				<DockPanel Grid.Row="2"
						   Grid.Column="1"
						   Grid.ColumnSpan="1"
					       LastChildFill="False"
					       HorizontalAlignment="Stretch"
				           Margin="0,0,0,0">

					<!-- ⚠️ IMPORTANTE: el PRIMERO va más a la DERECHA en un DockPanel con Dock=Right -->

					<!-- Selector (a la derecha del todo) -->
					<ComboBox DockPanel.Dock="Right"
							  Width="180" Height="36"
							  ItemsSource="{Binding GameStatus.Launchers}"
							  SelectedItem="{Binding GameStatus.SelectedLauncher}"
							  DisplayMemberPath="Display"
							  MaxDropDownHeight="200"
							  Margin="0,0,10,0"
							  Background="White"/>

					<!-- Botón Iniciar (queda a la IZQUIERDA del selector) -->
					<Button DockPanel.Dock="Right"
							x:Name="BtnIniciar"
							Content="Iniciar"
							Width="120" Height="36"
							Click="BtnIniciar_Click"
							IsEnabled="{Binding GameStatus.PuedeIniciar}"
							Style="{StaticResource GlassButtonStyle}"/>
				</DockPanel>


			</Grid>
		</Grid>
	</DockPanel>
</Window>
