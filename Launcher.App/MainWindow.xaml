<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher.App"
        mc:Ignorable="d"
        Title="Launcher 2.0" Height="800" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackground}">

	<DockPanel LastChildFill="True">

		<!-- MENÚ SUPERIOR -->
		<Menu DockPanel.Dock="Top" Background="{StaticResource PrimaryBackground}">
			<MenuItem Header="_Archivo" Foreground="{StaticResource PrimaryText}">
				<MenuItem Header="Abrir..." Foreground="{StaticResource PrimaryText}" />
				<Separator />
				<MenuItem Header="Salir" Foreground="{StaticResource PrimaryText}" Click="MenuSalir_Click"/>
			</MenuItem>

			<MenuItem Header="_Ver" Foreground="{StaticResource PrimaryText}">
				<MenuItem Header="Actualizar"
                          Foreground="{StaticResource PrimaryText}"
                          IsCheckable="True"
                          Click="MenuActualizar_Click"/>
			</MenuItem>

			<MenuItem Header="_Ayuda" Foreground="{StaticResource PrimaryText}">
				<MenuItem Header="Acerca de..." Foreground="{StaticResource PrimaryText}" Click="MenuAcercaDe_Click"/>
			</MenuItem>
		</Menu>

		<!-- BARRA SUPERIOR -->
		<Border DockPanel.Dock="Top" Padding="2" Background="#FF2D2F33">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Logo -->
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
					<Image Source="Assets/logo.png" Width="100" Height="100" Margin="0,0,10,0"/>
				</StackPanel>

				<!-- Título -->
				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock Text="Mi Launcher" Foreground="White" FontSize="20" FontWeight="Bold"/>
					<TextBlock Text="Panel principal" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
				</StackPanel>

				<!-- Acciones rápidas -->
				<StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
					<Button Content="Actualizar" Click="BtnActualizar_Click" Padding="8,4" Margin="0,0,8,0"/>
					<Button Content="Configuración" Click="BtnConfiguracion_Click" Padding="8,4"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- CUERPO PRINCIPAL -->
		<Grid Margin="12">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Pestañas -->
			<TabControl Grid.Row="0"
                        x:Name="MainTabs"
                        Margin="0,0,0,10"
                        Height="36"
                        Background="{StaticResource PrimaryBackground}"
                        BorderThickness="0"
                        SelectionChanged="MainTabs_SelectionChanged">
				<TabItem Header="Inicio" />
				<TabItem Header="Historial" />
			</TabControl>

			<!-- Contenido en dos columnas -->
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="3*"/>
					<ColumnDefinition Width="2*"/>
				</Grid.ColumnDefinitions>

				<!-- ESTADO -->
				<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock Text="Estado"
                                   Foreground="{StaticResource PrimaryText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="6"/>

						<!-- Tarjeta: Estado del launcher -->
						<Border Style="{StaticResource CardStyle}">
							<StackPanel>
								<TextBlock Text="Estado del launcher"
                                           Foreground="{StaticResource PrimaryText}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Margin="0,0,0,10"/>

								<!-- Versión instalada -->
								<StackPanel Orientation="Horizontal" Margin="0,4">
									<TextBlock Text="Versión instalada:"
                                               Foreground="{StaticResource PrimaryText}"
                                               FontWeight="Bold" Width="160"/>
									<TextBlock Text="{Binding GameStatus.VersionInstalada}"
                                               Foreground="{StaticResource SecondaryText}"/>
								</StackPanel>

								<!-- Última versión disponible -->
								<StackPanel Orientation="Horizontal" Margin="0,4">
									<TextBlock Text="Última versión:"
                                               Foreground="{StaticResource PrimaryText}"
                                               FontWeight="Bold" Width="160"/>
									<TextBlock Text="{Binding GameStatus.UltimaVersion}"
                                               Foreground="{StaticResource SecondaryText}"/>
								</StackPanel>

								<!-- Estado con icono + texto -->
								<StackPanel Orientation="Horizontal" Margin="0,8">
									<Image Source="{Binding GameStatus.IconoEstado}"
										   Width="18" Height="18" Margin="0,0,6,0"/>
									<TextBlock Text="{Binding GameStatus.TextoEstado}"
											   Foreground="{StaticResource SecondaryText}"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- Tarjeta: Estado de la conexión/launcher -->
						<Border Style="{StaticResource CardStyle}">
							<StackPanel>
								<TextBlock Text="Conexión:"
                                           Foreground="{StaticResource PrimaryText}"
                                           FontWeight="Bold"/>
								<TextBlock Text="{Binding LauncherStatus.ConnectionText}"
                                           Foreground="{StaticResource SecondaryText}"
                                           Margin="0,4,0,8"/>

								<TextBlock Text="Versión:"
                                           Foreground="{StaticResource PrimaryText}"
                                           FontWeight="Bold"/>
								<TextBlock Text="{Binding LauncherStatus.Version}"
                                           Foreground="{StaticResource SecondaryText}"
                                           Margin="0,4,0,8"/>

								<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
									<Button Content="Revisar actualizaciones"
                                            Click="BtnRevisarActualizaciones_Click"
                                            Padding="8,4" />
									<Button Content="Reiniciar"
                                            Click="BtnReiniciar_Click"
                                            Padding="8,4"
                                            Margin="8,0,0,0"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- Tarjeta Actividades -->
						<Border Style="{StaticResource CardStyle}">
							<StackPanel>
								<TextBlock Text="Actividades recientes"
                                           Foreground="{StaticResource PrimaryText}"
                                           FontWeight="Bold" />
								<ItemsControl ItemsSource="{Binding RecentActivities}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}">
												<Run Text="• "/>
												<Run Text="{Binding}" />
											</TextBlock>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>

				<!-- NOTICIAS -->
				<StackPanel Grid.Column="1">
					<TextBlock Text="Noticias" Foreground="{StaticResource PrimaryText}" FontSize="18" FontWeight="SemiBold" Margin="6"/>

					<!-- Tarjeta Noticias -->
					<Border Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>

							<!-- Filtros -->
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
								<TextBlock Text="Filtrar:" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
								<ComboBox Width="140" SelectedIndex="0">
									<ComboBoxItem Content="Todas"/>
									<ComboBoxItem Content="Actualizaciones"/>
									<ComboBoxItem Content="Promociones"/>
								</ComboBox>
							</StackPanel>

							<!-- Lista noticias -->
							<ListView Grid.Row="1" ItemsSource="{Binding NewsItems}" Margin="0,8,0,0" Name="NewsListView">
								<ListView.ItemTemplate>
									<DataTemplate>
										<Border Padding="8" Margin="4" CornerRadius="6" Background="Transparent">
											<StackPanel>
												<TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryText}" FontWeight="Bold"/>
												<TextBlock Text="{Binding Summary}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
												<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
													<TextBlock Text="{Binding DateString}" FontSize="11" Foreground="#FF8A8D90"/>
													<Button Content="Abrir" Margin="8,0,0,0" Padding="6,2" Tag="{Binding}" Click="BtnAbrirNoticia_Click"/>
												</StackPanel>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>
						</Grid>
					</Border>
				</StackPanel>
			</Grid>
		</Grid>
	</DockPanel>
</Window>