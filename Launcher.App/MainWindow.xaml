<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher.App"
        mc:Ignorable="d"
        Title="Launcher 2.0" Height="800" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackground}">

        <Window.Resources>
                <LinearGradientBrush x:Key="GlassButtonBackground" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B3FFFFFF" Offset="0"/>
                        <GradientStop Color="#80FFFFFF" Offset="0.35"/>
                        <GradientStop Color="#4C5AC8FF" Offset="1"/>
                </LinearGradientBrush>

                <LinearGradientBrush x:Key="GlassButtonHoverBackground" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CCFFFFFF" Offset="0"/>
                        <GradientStop Color="#99FFFFFF" Offset="0.35"/>
                        <GradientStop Color="#666EA5FF" Offset="1"/>
                </LinearGradientBrush>

                <Style x:Key="GlassButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="160"/>
                        <Setter Property="Height" Value="52"/>
                        <Setter Property="Padding" Value="18,8"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#FF0D0D0D"/>
                        <Setter Property="Background" Value="{StaticResource GlassButtonBackground}"/>
                        <Setter Property="BorderBrush" Value="#80FFFFFF"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Effect">
                                <Setter.Value>
                                        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Direction="270" Color="#40000000"/>
                                </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="24">
                                                        <Grid>
                                                                <Border Background="#33FFFFFF"
                                                                        CornerRadius="20"
                                                                        Margin="6,6,6,0"
                                                                        Height="Auto"
                                                                        VerticalAlignment="Top"/>
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                        </Grid>
                                                </Border>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource GlassButtonHoverBackground}"/>
                                        <Setter Property="BorderBrush" Value="#B3FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background">
                                                <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#99FFFFFF" Offset="0"/>
                                                                <GradientStop Color="#80FFFFFF" Offset="0.4"/>
                                                                <GradientStop Color="#80527CFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                </Setter.Value>
                                        </Setter>
                                        <Setter Property="Effect">
                                                <Setter.Value>
                                                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Color="#40000000"/>
                                                </Setter.Value>
                                        </Setter>
                                </Trigger>
                        </Style.Triggers>
                </Style>
        </Window.Resources>

	<DockPanel LastChildFill="True">

		<!-- MENÚ SUPERIOR -->
		<Menu DockPanel.Dock="Top" Background="{StaticResource PrimaryBackground}">
			<MenuItem Header="_Archivo" Foreground="{StaticResource PrimaryText}" >
				<MenuItem Header="Abrir..." Foreground="#0D0D0D" IsCheckable="True" IsChecked="True" />
				<Separator />
				<MenuItem Header="Salir" Foreground="#0D0D0D" IsCheckable="True" IsChecked="True" Click="MenuSalir_Click"/>
			</MenuItem>
			
			<MenuItem Header="_Ver" Foreground="{StaticResource PrimaryText}">
				<MenuItem Header="Actualizar"
						  Foreground="#0D0D0D"
						  IsCheckable="True"
						  IsChecked="True"
						  Click="MenuActualizar_Click"/>
			</MenuItem>
			
			<MenuItem Header="_Ayuda" Foreground="{StaticResource PrimaryText}" >
				<MenuItem Header="Acerca de..." Foreground="#0D0D0D" IsCheckable="True"
						  IsChecked="True" Click="MenuAcercaDe_Click"/>
			</MenuItem>
		</Menu>

		<!-- BARRA SUPERIOR -->
		<Border DockPanel.Dock="Top" Padding="10" Background="#FF2D2F33">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Logo -->
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
					<Image Source="Assets/logo.png" Width="38" Height="38" Margin="0,0,10,0"/>
				</StackPanel>

				<!-- Título -->
				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock Text="Mi Launcher" Foreground="White" FontSize="20" FontWeight="Bold"/>
					<TextBlock Text="Panel principal" Foreground="{StaticResource SecondaryText}" FontSize="12"/>
				</StackPanel>

				<!-- Acciones rápidas -->
				<StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
					<Button Content="Actualizar" Click="BtnActualizar_Click" Padding="8,4" Margin="0,0,8,0"/>
					<Button Content="Configuración" Click="BtnConfiguracion_Click" Padding="8,4"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- CUERPO PRINCIPAL -->
		<Grid Margin="12">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Pestañas -->
			<TabControl  Grid.Row="0"
            x:Name="MainTabs"
            Margin="0,0,0,10"
            Height="36"
            Background="{StaticResource CardBackground}" 
            BorderThickness="0"
            SelectionChanged="MainTabs_SelectionChanged">
				<TabItem Header="Inicio" />
				<TabItem Header="Historial" />
			</TabControl>

			<!-- Contenido en dos columnas -->
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="3*"/>
					<ColumnDefinition Width="2*"/>
				</Grid.ColumnDefinitions>

				<!-- ESTADO -->
				<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
					<StackPanel>
						<TextBlock Text="Estado" Foreground="{StaticResource PrimaryText}" FontSize="18" FontWeight="SemiBold" Margin="6"/>

						<!-- Tarjeta Estado -->
						<Border Style="{StaticResource CardStyle}">
							<StackPanel>
								<TextBlock Text="Conexión:" Foreground="{StaticResource PrimaryText}" FontWeight="Bold"/>
								<TextBlock Text="{Binding LauncherStatus.ConnectionText}" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,8"/>
								<TextBlock Text="Versión:" Foreground="{StaticResource PrimaryText}" FontWeight="Bold"/>
								<TextBlock Text="{Binding LauncherStatus.Version}" Foreground="{StaticResource SecondaryText}" Margin="0,4,0,8"/>
								<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
									<Button Content="Revisar actualizaciones" Click="BtnRevisarActualizaciones_Click" Padding="8,4" />
									<Button Content="Reiniciar" Click="BtnReiniciar_Click" Padding="8,4" Margin="8,0,0,0"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- Tarjeta Actividades -->
						<Border Style="{StaticResource CardStyle}">
							<StackPanel>
								<TextBlock Text="Actividades recientes" Foreground="{StaticResource PrimaryText}" FontWeight="Bold" />
								<ItemsControl ItemsSource="{Binding RecentActivities}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}">
												<Run Text="• "/>
												<Run Text="{Binding}" />
											</TextBlock>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>

				<!-- NOTICIAS -->
				<StackPanel Grid.Column="1">
					<TextBlock Text="Noticias" Foreground="{StaticResource PrimaryText}" FontSize="18" FontWeight="SemiBold" Margin="6"/>

					<!-- Tarjeta Noticias -->
					<Border Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>

							<!-- Filtros -->
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
								<TextBlock Text="Filtrar:" Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
								<ComboBox Width="140" SelectedIndex="0">
									<ComboBoxItem Content="Todas"/>
									<ComboBoxItem Content="Actualizaciones"/>
									<ComboBoxItem Content="Promociones"/>
								</ComboBox>
							</StackPanel>

							<!-- Lista noticias -->
							<ListView Grid.Row="1" ItemsSource="{Binding NewsItems}" Margin="0,8,0,0" Name="NewsListView">
								<ListView.ItemTemplate>
									<DataTemplate>
										<Border Padding="8" Margin="4" CornerRadius="6" Background="Transparent">
											<StackPanel>
												<TextBlock Text="{Binding Title}" Foreground="{StaticResource PrimaryText}" FontWeight="Bold"/>
												<TextBlock Text="{Binding Summary}" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
												<StackPanel Orientation="Horizontal" Margin="0,6,0,0">
													<TextBlock Text="{Binding DateString}" FontSize="11" Foreground="#FF8A8D90"/>
													<Button Content="Abrir" Margin="8,0,0,0" Padding="6,2" Tag="{Binding}" Click="BtnAbrirNoticia_Click"/>
												</StackPanel>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ListView.ItemTemplate>
							</ListView>
						</Grid>
					</Border>
				</StackPanel>
			</Grid>

		<Button Content="Jugar"
			Grid.Row="1"
			Style="{StaticResource GlassButtonStyle}"
			HorizontalAlignment="Right"
			VerticalAlignment="Bottom"
			Margin="0,0,24,24"/>

		</Grid>
	</DockPanel>
</Window>
