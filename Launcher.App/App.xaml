<Application x:Class="Launcher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

	<Application.Resources>

		<!-- 🎨 Colores -->
		<SolidColorBrush x:Key="PrimaryBackground" Color="#1B1D2A"/>
		<SolidColorBrush x:Key="CardBackground" Color="#2A2D3E"/>
		<SolidColorBrush x:Key="AccentBrush" Color="#4A90E2"/>
		<SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
		<SolidColorBrush x:Key="SecondaryText" Color="#A0A3B1"/>

		<!-- 🌟 Efecto de sombra -->
		<DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Color="Black" Opacity="0.4"/>

		<!-- 📦 Estilo para tarjetas -->
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource CardBackground}"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="12"/>
			<Setter Property="Margin" Value="10"/>
			<Setter Property="Effect" Value="{StaticResource CardShadow}"/>
		</Style>

		<!-- 🔘 Estilo global para botones -->
		<Style TargetType="Button">
			<Setter Property="Background" Value="{StaticResource AccentBrush}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="Margin" Value="4"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<!-- Hover -->
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#6AA9E9"/>
							</Trigger>
							<!-- Click -->
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Background" Value="#357ABD"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</Application.Resources>
</Application>
