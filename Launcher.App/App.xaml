<Application x:Class="Launcher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

	<Application.Resources>

		<!-- 🎨 Colores -->
        <SolidColorBrush x:Key="PrimaryBackground" Color="#ededed"/>
		<!-- Fondo -->
		<SolidColorBrush x:Key="CardBackground" Color="#2A2D3E"/>
		<!-- Tarjetas -->
        <SolidColorBrush x:Key="AccentBrush" Color="#003594"/>
		<!-- Botones / acentos -->
        <SolidColorBrush x:Key="PrimaryText" Color="#ededed"/>
		<!-- Texto principal -->
        <SolidColorBrush x:Key="SecondaryText" Color="#ededed"/>
		<!-- Texto secundario -->

		<!-- 🌟 Efecto de sombra -->
		<DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Color="Black" Opacity="0.4"/>

		<!-- 📦 Estilo para tarjetas -->
		<Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="#003594"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="12"/>
			<Setter Property="Margin" Value="10"/>
			<Setter Property="Effect" Value="{StaticResource CardShadow}"/>
		</Style>

		<!-- 🔘 Estilo global para botones -->
		<Style TargetType="Button">
			<Setter Property="Background" Value="{StaticResource AccentBrush}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="Margin" Value="4"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<!-- Hover -->
							<Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#003594"/>
							</Trigger>
							<!-- Click -->
							<Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#003594"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 📋 Estilo global para menús -->
		<Style TargetType="MenuItem">
			<Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
			<Setter Property="Background" Value="{StaticResource PrimaryBackground}"/>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{StaticResource AccentBrush}"/>
				</Trigger>
				<Trigger Property="IsSubmenuOpen" Value="True">
					<Setter Property="Background" Value="{StaticResource AccentBrush}"/>
				</Trigger>
			</Style.Triggers>
		</Style>
		<!-- 🔠 Tipografía global -->
		<Style TargetType="TextBlock">
			<Setter Property="FontFamily" Value="Tahoma"/>
			<Setter Property="FontSize" Value="14"/>
			
		</Style>
		<!-- 🅰️ Estilos de fuente -->
		<FontFamily x:Key="ManropeLight">/Assets/Fonts/#Manrope Light</FontFamily>
		<FontFamily x:Key="ManropeRegular">/Assets/Fonts/#Manrope</FontFamily>
		<FontFamily x:Key="ManropeSemiBold">/Assets/Fonts/#Manrope SemiBold</FontFamily>
		<FontFamily x:Key="ManropeBold">/Assets/Fonts/#Manrope Bold</FontFamily>
		<FontFamily x:Key="ManropeExtraBold">/Assets/Fonts/#Manrope ExtraBold</FontFamily>
		<FontFamily x:Key="ManropeExtraLight">/Assets/Fonts/#Manrope Bold</FontFamily>
		<FontFamily x:Key="ManropeMedium">/Assets/Fonts/#Manrope ExtraBold</FontFamily>
		<!-- 🧱 Estilos tipográficos globales -->
		<Style x:Key="Titulo" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="{StaticResource ManropeLight}"/>
			<Setter Property="FontSize" Value="24"/>
			<Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
		</Style>

		<Style x:Key="TituloSecundario" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="{StaticResource ManropeSemiBold}"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
		</Style>

		<Style x:Key="Texto" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="{StaticResource ManropeRegular}"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
		</Style>

		<Style x:Key="TextoDestacado" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="{StaticResource ManropeBold}"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
		</Style>

		<Style x:Key="BotonTexto" TargetType="Button">
			<Setter Property="FontFamily" Value="{StaticResource ManropeBold}"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<!-- 📑 Estilo para TabControl -->
		<Style TargetType="TabControl">
			<Setter Property="Background" Value="{StaticResource PrimaryBackground}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="6"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TabControl">
						<DockPanel>
							<!-- Panel de pestañas -->
							<TabPanel DockPanel.Dock="Top"
                                      IsItemsHost="True"
                                      Background="{TemplateBinding Background}"
                                      Margin="0,0,0,6" />

							<!-- Contenido -->
							<ContentPresenter ContentSource="SelectedContent"
                                              Margin="0"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
						</DockPanel>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#003594"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
								CornerRadius="12"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#003594"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#003594"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 📑 Estilo para TabItem -->
		<Style TargetType="TabItem">
			<Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
			<Setter Property="Background" Value="{StaticResource CardBackground}"/>
			<Setter Property="Padding" Value="12,6"/>
			<Setter Property="Margin" Value="4,0,0,0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TabItem">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
							<TextBlock Text="{TemplateBinding Header}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
						</Border>
						<ControlTemplate.Triggers>
							<!-- Seleccionada -->
							<Trigger Property="IsSelected" Value="True">
								<Setter Property="Background" Value="{StaticResource AccentBrush}"/>
								<Setter Property="Foreground" Value="White"/>
							</Trigger>
							<!-- Hover -->
							<Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#003594"/>
								<Setter Property="Foreground" Value="White"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Application.Resources>
</Application>